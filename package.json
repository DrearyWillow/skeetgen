{
	"packageManager": "pnpm@9.1.0",
	"private": true,
	"type": "module",
	"name": "bluesky-archiver",
	"scripts": {
		"dev": "vite",
		"build": "tsc && pnpm run gen && vite build",
		"publish": "pnpm run build && scripts/publish.sh",
		"gen": "wireit",
		"preview": "vite preview",
		"fmt": "prettier --cache --write ."
	},
	"wireit": {
		"gen": {
			"dependencies": [
				"gen:archive_css",
				"gen:archive_search_js",
                "gen:archive_alt_text_js"
			]
		},
		"gen:archive_css": {
			"command": "tailwindcss -i src_templates/styles/index.css -o public/archive_assets/style.css --minify",
			"files": [
				"src_templates/styles/**/*.css"
			],
			"output": [
				"public/archive_assets/style.css"
			]
		},
		"gen:archive_search_js": {
			"command": "esbuild src_templates/scripts/search.js --bundle --format=iife --outfile=public/archive_assets/search.js --minify-syntax --minify-whitespace",
			"files": [
				"src_templates/scripts/search.js",
				"src_templates/scripts/dependencies/**/*.js"
			],
			"output": [
				"public/archive_assets/search.js"
			]
		},
        "gen:archive_alt_text_js": {
            "command": "esbuild src_templates/scripts/alt-text-overlay.js --bundle --format=iife --outfile=public/archive_assets/alt-text-overlay.js --minify-syntax --minify-whitespace",
            "files": [
            "src_templates/scripts/alt-text-overlay.js"
            ],
            "output": [
            "public/archive_assets/alt-text-overlay.js"
            ]
        }
	},
	"dependencies": {
		"@akryum/flexsearch-es": "^0.7.32",
		"@ipld/car": "^5.3.0",
		"@ipld/dag-cbor": "^9.2.0",
		"@mary/bluesky-client": "npm:@jsr/mary__bluesky-client@^0.5.17",
		"multiformats": "^12.1.3",
		"native-file-system-adapter": "^3.0.1",
		"p-map": "^7.0.2"
	},
	"devDependencies": {
		"@babel/core": "^7.24.6",
		"@babel/plugin-syntax-typescript": "^7.24.6",
		"@intrnl/jsx-to-string": "^0.1.6",
		"@minify-html/node": "0.11.1",
		"@rollup/plugin-babel": "^6.0.4",
		"@tailwindcss/forms": "^0.5.7",
		"autoprefixer": "^10.4.19",
		"esbuild": "^0.19.12",
		"postcss": "^8.4.38",
		"prettier": "^3.2.5",
		"prettier-plugin-tailwindcss": "^0.5.14",
		"tailwindcss": "^3.4.3",
		"terser": "^5.31.0",
		"typescript": "^5.4.5",
		"vite": "^5.2.11",
		"wireit": "^0.14.4"
	},
	"pnpm": {
		"patchedDependencies": {
			"native-file-system-adapter@3.0.1": "patches/native-file-system-adapter@3.0.1.patch"
		}
	}
}
